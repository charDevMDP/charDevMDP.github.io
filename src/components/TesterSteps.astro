---
import { t } from '../lib/i18n';
import type { Lang } from '../lib/langs';

interface Props {
  lang: Lang;
  kind: 'join' | 'leave';
  groupUrl?: string | null;
  optInUrl?: string | null;
  installUrl?: string | null;
}
const { lang, kind, groupUrl = null, optInUrl = null, installUrl = null } = Astro.props;

const steps =
  kind === 'join'
    ? [
        { text: t(lang, 'tester.join.step1'), href: groupUrl, cta: t(lang, 'tester.join.cta1'), hint: '' },
        { text: t(lang, 'tester.join.step2'), href: optInUrl, cta: t(lang, 'tester.join.cta2'), hint: '' },
        {
          text: t(lang, 'tester.join.step3'),
          href: installUrl,
          cta: t(lang, 'tester.join.cta3'),
          hint: installUrl ? t(lang, 'tester.join.hint3') : '',
        },
      ]
    : [
        { text: t(lang, 'tester.leave.step1'), href: optInUrl, cta: t(lang, 'tester.leave.cta1'), hint: '' },
        { text: t(lang, 'tester.leave.step2'), href: null, cta: '', hint: '' },
        { text: t(lang, 'tester.leave.step3'), href: groupUrl, cta: t(lang, 'tester.leave.cta3'), hint: '' },
      ];
---
<ol class="steps">
  {steps.map((s) => (
    <li>
      <p>{s.text}</p>
      {s.href && (
        <a class="btn btn-ghost" href={s.href} target="_blank" rel="noopener">
          {s.cta}<span class="sr-only"> {t(lang, 'a11y.newTab')}</span>
        </a>
      )}
      {s.hint && <p class="step-hint">{s.hint}</p>}
    </li>
  ))}
</ol>
